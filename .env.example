# Copy this file to .env and fill in your real values.
# .env is gitignored -- it will never be committed.

IMAP_USER=your@email.com
IMAP_PASSWORD=your-password
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_TLS=true

# Optional: additional IMAP accounts. Add a numeric suffix (_2, _3, ...) for
# each extra account -- every email cached from it is tagged with its
# address so imports from different mailboxes never mix. Uncomment and fill
# in to enable a second account:
# IMAP_USER_2=your-second@email.com
# IMAP_PASSWORD_2=your-second-password
# IMAP_HOST_2=imap.example.com
# IMAP_PORT_2=993
# IMAP_TLS_2=true

# Optional: path to the local SQLite cache used by imap_import_recent /
# imap_list_cached. Defaults to imap_cache.db next to the source files.
# IMAP_CACHE_DB=./imap_cache.db
